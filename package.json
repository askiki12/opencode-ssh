{
  "name": "opencode-ssh",
  "version": "0.1.0",
  "description": "OpenCode plugin for persistent SSH connections, encrypted profiles, and remote command execution",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:tui": "tsx scripts/tui-smoke.ts",
    "test": "npm run test:smoke && npm run test:tui"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.7",
    "picomatch": "^4.0.7",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@opencode/theme": "^2.2.7",
    "@opentui/core": "^0.8.4",
    "@opentui/solid": "^0.8.4",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/ssh2": "^1.15.6",
    "solid-js": "^1.9.19",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
